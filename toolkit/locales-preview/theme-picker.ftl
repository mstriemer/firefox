# Heading for the in-product themes selector section
themes-selector-heading = { -brand-product-name } themes

# Tab labels for the themes selector (Light/Dark/Device)
themes-selector-tab-light = Light
themes-selector-tab-dark = Dark
themes-selector-tab-device = Device

# Show more / show less button at the bottom of the themes selector
themes-selector-see-more = Show more
themes-selector-see-less = Show less

# Enable/disable buttons on each theme card in the themes selector
themes-selector-enable-button =
    .label = Enable

themes-selector-disable-button =
    .label = Disable

# Prototype theme names shown in the themes selector
themes-selector-name-default =
  .label = Default
themes-selector-name-ash =
  .label = Ash
themes-selector-name-smoke =
  .label = Smoke
themes-selector-name-sun =
  .label = Sun
themes-selector-name-spark =
  .label = Spark
themes-selector-name-flame =
  .label = Flame
themes-selector-name-flare =
  .label = Flare
themes-selector-name-lavender =
  .label = Lavender
themes-selector-name-dusk =
  .label = Dusk
themes-selector-name-lagoon =
  .label = Lagoon
themes-selector-name-tide =
  .label = Tide
